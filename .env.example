# Copy to .env and fill in. .env is gitignored.

# --- App ---
PORT=8191
# Public URL the browser uses. MUST be the real external origin in production
# (e.g. https://dora.example.com), not localhost — Server Actions (the login
# form) reject POSTs whose Origin doesn't match this host with a 403.
NEXTAUTH_URL=http://localhost:8191
# Only if the reverse proxy forwards a host that differs from NEXTAUTH_URL, or to
# allow extra origins. Comma-separated host[:port], no scheme.
# SERVER_ACTIONS_ALLOWED_ORIGINS=dora.example.com
# Auth.js session secret — generate: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Database (Drizzle + postgres.js) ---
# NOTE: no ?schema= param (that is Prisma-only and breaks postgres.js).
DATABASE_URL=postgresql://dora:dora@localhost:5432/dora

# --- Secrets encryption ---
# 32-byte base64 key for AES-256-GCM encryption of integration tokens.
# generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Bootstrap admin (seeded by scripts/seed.mjs) ---
BOOTSTRAP_ADMIN_EMAIL=admin@dora.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# --- SSO / OAuth / integrations ---
# Entra ID SSO, GitHub OAuth, and GitLab/Jira integrations are configured
# in-app via Settings (persisted in the DB), not through env vars.

# --- Feature flags ---
# Show GitHub integration + GitHub OAuth sign-in (hidden by default).
FEATURE_GITHUB=false
